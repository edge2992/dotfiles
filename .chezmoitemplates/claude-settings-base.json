{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Read(**)",
      "Read(~/.claude/**)",
      "Edit(**)",
      "Edit(**.md)",
      "Edit(/tmp/**)",
      "Edit(.tmp/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(make:*)",
      "Bash(shellcheck:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(echo:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(diff:*)",
      "Bash(date:*)",
      "Bash(uname:*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__aws-docs__read_documentation",
      "mcp__aws-docs__read_sections",
      "mcp__aws-docs__recommend",
      "mcp__aws-docs__search_documentation",
      "mcp__aws-knowledge-mcp-server__aws___get_regional_availability",
      "mcp__aws-knowledge-mcp-server__aws___list_regions",
      "mcp__aws-knowledge-mcp-server__aws___read_documentation",
      "mcp__aws-knowledge-mcp-server__aws___recommend",
      "mcp__aws-knowledge-mcp-server__aws___search_documentation",
      "mcp__aws-mcp__aws___call_aws",
      "mcp__aws-mcp__aws___recommend",
      "mcp__aws-mcp__aws___search_documentation",
      "mcp__aws-mcp__aws___suggest_aws_commands",
      "mcp__datadog-mcp__aggregate_spans",
      "mcp__datadog-mcp__analyze_datadog_logs",
      "mcp__datadog-mcp__get_datadog_metric_context",
      "mcp__datadog-mcp__get_datadog_trace",
      "mcp__datadog-mcp__list_datadog_skills",
      "mcp__datadog-mcp__load_datadog_skill",
      "mcp__datadog-mcp__search_datadog_hosts",
      "mcp__datadog-mcp__search_datadog_logs",
      "mcp__datadog-mcp__search_datadog_metrics",
      "mcp__datadog-mcp__search_datadog_service_dependencies",
      "mcp__datadog-mcp__search_datadog_services",
      "mcp__datadog-mcp__search_datadog_spans",
      "mcp__mcp-atlassian__confluence_get_attachments",
      "mcp__mcp-atlassian__confluence_get_page",
      "mcp__mcp-atlassian__confluence_get_page_children",
      "mcp__mcp-atlassian__confluence_search",
      "mcp__mcp-atlassian__jira_get_agile_boards",
      "mcp__mcp-atlassian__jira_get_all_projects",
      "mcp__mcp-atlassian__jira_get_board_issues",
      "mcp__mcp-atlassian__jira_get_issue",
      "mcp__mcp-atlassian__jira_get_link_types",
      "mcp__mcp-atlassian__jira_get_project_issues",
      "mcp__mcp-atlassian__jira_get_sprint_issues",
      "mcp__mcp-atlassian__jira_get_sprints_from_board",
      "mcp__mcp-atlassian__jira_get_transitions",
      "mcp__mcp-atlassian__jira_get_user_profile",
      "mcp__mcp-atlassian__jira_get_worklog",
      "mcp__mcp-atlassian__jira_search",
      "mcp__mcp-atlassian__jira_search_fields",
      "mcp__playwright",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__serena"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(chezmoi destroy:*)",
      "Bash(chezmoi purge:*)",
      "Read(.env*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(~/.config/opencode/opencode.jsonc)",
      "Edit(.env*)"
    ],
    "defaultMode": "plan"
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(~/.claude/settings.json)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/settings-sync.sh"
          }
        ]
      },
      {
        "matcher": "Edit(~/.claude/settings.json)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/settings-sync.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/turn-start-record.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-review.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worklog.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "eli5@claude-community": true,
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "language": "japanese",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "editorMode": "vim",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "skipWorkflowUsageWarning": true,
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "timeFormat": "auto",
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(bin/inbox:*) in /Users/edgissa/ghq/github.com/edge2992/idea_inbox",
      "Bash(uv run:*) in /Users/edgissa/ghq/github.com/edge2992/idea_inbox",
      "Bash(uv add:*) in /Users/edgissa/ghq/github.com/edge2992/idea_inbox"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: AWS (via `mcp__aws-mcp__aws___call_aws`, per ~/.claude/CLAUDE.md; hosts aws-mcp.ap-northeast-1.api.aws and knowledge-mcp.global.api.aws contacted)",
      "**Repository visibility**: private (edge2992/idea_inbox, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no classic protected branches listed, rulesets not queryable here so protection status is not fully confirmed — treat main as sensitive to force-push/history-rewrite regardless",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (edge2992/idea_inbox) and its origin remote (ssh://github.com/edge2992/idea_inbox.git) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: topics/cloud-iac/tickets/t3-cloudflare-terraform.md (Cloudflare/IaC-related ticket content) — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment; also treat topics/cloud-iac/tickets/t3-cloudflare-terraform.md's Terraform/Cloudflare scope with care",
      "### User-specific",
      "**Primary use of Claude Code**: personal idea/task inbox management (idea_inbox repo) — Markdown ticket tracking for self and agent delegation (Claude Code, Grok Bot)",
      "**Trusted repo**: /Users/edgissa/ghq/github.com/edge2992/idea_inbox (private) and its origin remote",
      "**Org-specific CLIs**: bin/inbox (project ticket CLI, Python stdlib only); uv for Python (per ~/.claude/CLAUDE.md, never pip or bare python)",
      "Routine under edge2992/idea_inbox prefix: ticket/topic edits, bin/inbox operations, and git commit/push/PR to origin are routine per repo conventions (CLAUDE.md: \"Commit, push, and open PRs without asking\")"
    ]
  }
}
