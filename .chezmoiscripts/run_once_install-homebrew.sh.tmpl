#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "install-prelude.sh" }}

{{ if eq .chezmoi.os "darwin" }}
# Bootstrap Homebrew itself only. Package declarations live in
# .chezmoitemplates/Brewfile and are installed by run_after_10_brew-bundle.sh,
# which re-runs whenever that Brewfile changes — unlike this run_once_ script,
# which would never pick up newly added packages on an existing machine.
echo "Installing Homebrew for macOS"

if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add Homebrew to PATH for the rest of this apply.
  if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
fi
{{ end }}
