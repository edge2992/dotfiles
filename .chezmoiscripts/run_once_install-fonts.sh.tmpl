#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "install-prelude.sh" }}

if [[ "${SKIP_NERD_FONTS_INSTALL:-}" == "true" ]]; then
  log "Skipping Nerd Fonts installation due to SKIP_NERD_FONTS_INSTALL."
  exit 0
fi

# Check if UbuntuMono Nerd Font is already installed
font_dir="${HOME}/.local/share/fonts"
if ls "${font_dir}"/UbuntuMono*.ttf >/dev/null 2>&1; then
  log "UbuntuMono Nerd Font is already installed, skipping"
  exit 0
fi

# nerd-fonts version: v3.4.0
NERD_FONTS_VERSION="v3.4.0"

log "Installing UbuntuMono Nerd Font..."
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/${NERD_FONTS_VERSION}/UbuntuMono.tar.xz" \
  -o "$tmpdir/UbuntuMono.tar.xz"
tar -xf "$tmpdir/UbuntuMono.tar.xz" -C "$tmpdir"

for font in "$tmpdir"/*.ttf; do
  install -Dm644 "$font" "${font_dir}/$(basename "$font")"
done

if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -f "${font_dir}"
fi

log "UbuntuMono Nerd Font installed"
