#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "install-prelude.sh" }}

{{ if eq .chezmoi.os "linux" }}
# AWS CLI v2 (official bundle). macOS gets awscli from the Brewfile instead.
# Installed per-user under ~/.local so no sudo is needed; `unzip` comes from
# run_once_before_install-build-deps. Needed by
# run_onchange_after_setup-aws-agent-toolkit, which registers aws-mcp.
export PATH="$HOME/.local/bin:$PATH"

if command -v aws >/dev/null 2>&1; then
  log "AWS CLI is already installed: $(aws --version 2>&1)"
  exit 0
fi

AWS_INSTALL_DIR="$HOME/.local/aws-cli"
AWS_BIN_DIR="$HOME/.local/bin"

if [ ! -x "$AWS_INSTALL_DIR/v2/current/bin/aws" ]; then
  case "$(uname -m)" in
    x86_64) AWS_ARCH="x86_64" ;;
    aarch64) AWS_ARCH="aarch64" ;;
    *)
      log "Unsupported architecture for AWS CLI: $(uname -m)"
      exit 1
      ;;
  esac

  log "Installing AWS CLI v2..."
  workdir=$(mktemp -d)
  trap 'rm -rf "$workdir"' EXIT
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" -o "$workdir/awscliv2.zip"
  unzip -q "$workdir/awscliv2.zip" -d "$workdir"
  "$workdir/aws/install" --install-dir "$AWS_INSTALL_DIR" --bin-dir "$AWS_BIN_DIR"
fi

# Re-link unconditionally: the installer skips an already-present version
# without restoring missing bin links, so a retry would otherwise stay broken.
mkdir -p "$AWS_BIN_DIR"
ln -sf "$AWS_INSTALL_DIR/v2/current/bin/aws" "$AWS_BIN_DIR/aws"
ln -sf "$AWS_INSTALL_DIR/v2/current/bin/aws_completer" "$AWS_BIN_DIR/aws_completer"

if ! aws --version >/dev/null 2>&1; then
  log "aws still not usable after install; PATH is: $PATH"
  exit 1
fi
log "AWS CLI installed: $(aws --version 2>&1)"
{{ end }}
