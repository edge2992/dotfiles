#!/usr/bin/env bash
set -euo pipefail
{{ includeTemplate "install-prelude.sh" }}

# Third-party Claude Code skills installed with the `skills` CLI
# (vercel-labs/skills). Like the AWS agent-toolkit skills, they are fetched
# from upstream (and refreshed with `npx skills update`) rather than vendored
# into the chezmoi source.

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
export PATH="$VOLTA_HOME/bin:$PATH"

if ! command -v npx >/dev/null 2>&1; then
  log "npx not found. Skipping agent skills install."
  exit 0
fi

log "Installing agent skills (mattpocock/skills, vercel-labs/skills)"
npx -y skills add mattpocock/skills -g -a claude-code -y \
  -s grill-me -s grill-with-docs -s grilling -s domain-modeling ||
  log "mattpocock/skills install failed; rerun it manually."
npx -y skills add vercel-labs/skills -g -a claude-code -y -s find-skills ||
  log "vercel-labs/skills install failed; rerun it manually."
