# alias for zsh
alias vim='nvim'
alias g='cd $(ghq list -p | fzf)'
alias vlast='vim "$(ls -1 | tail -n 1)"'

# alias for isucon
alias m='make'
alias ma='m before-bench && sleep 5 && ((m sql-all;) & m bench) && m after-bench; '
alias slackcat='cat'

# global claude
alias cw='claude -w'

# ls command
# eza blocks when stdin is an open non-TTY pipe (e.g. Claude Code background
# shells), so only use it when both stdin and stdout are terminals.
unalias ls 2> /dev/null
if command -v eza &> /dev/null; then
  ls() {
    if [[ -t 0 && -t 1 ]]; then
      eza --icons --group --git --group-directories-first "$@"
    else
      command ls "$@"
    fi
  }
else
  alias ls='ls --color=auto {{ if eq .chezmoi.os "linux" }}--group-directories-first {{ end }}-h'
fi

{{ if eq .chezmoi.os "darwin" }}
# open shortcut (consistent with Linux xdg-open)
alias xdg-open='open'
{{ end }}

# git worktree aliases
alias gwt='git worktree list'
alias gwta='git worktree add'
alias gwtr='git worktree remove'
